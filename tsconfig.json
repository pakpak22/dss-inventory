{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@dss/ui": ["./vendor/dss-ui/src/index.ts"],
      "@dss/ui/styles.css": ["./vendor/dss-ui/src/service-menu/service-menu.css"],
      "@dss/ui/notification-bell.css": ["./vendor/dss-ui/src/notification-bell/notification-bell.css"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "src/lib/xlsx/customer-portal-export-workbook.ts"
  ]
}
