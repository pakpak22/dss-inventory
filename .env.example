# 이름만 둔다. 값은 .env.local 에 채운다 (.env.local 은 git 에 올라가지 않는다).
# 없으면 앱이 조용히 기본값으로 넘어가지 않고 시작할 때 명확히 멈춘다 (src/lib/env.ts).

# ── 데이터베이스 ─────────────────────────────────────────────────────────────
# 개발 DB 포트는 5450 (5448 은 휴가 관리 시스템의 DB가 쓴다 — 2026-10-06 정정)
DATABASE_URL=postgres://dss_inventory_app:CHANGE_ME@127.0.0.1:5450/dss_inventory_dev
# docker-compose 가 읽는 값. DATABASE_URL 의 비밀번호와 같아야 한다.
DEV_POSTGRES_PASSWORD=

# ── 앱 ───────────────────────────────────────────────────────────────────────
# 앱 포트는 3800 (3700 은 휴가 관리 시스템 — 2026-10-06 정정). package.json 스크립트가 -p 3800 으로 띄운다.
PORT=3800

# ── 세션 ─────────────────────────────────────────────────────────────────────
# 32자 이상. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=
# HTTPS 를 붙인 뒤에 true. 사내망 HTTP 에서 true 로 두면 쿠키가 저장되지 않아 로그인이 조용히 실패한다.
SESSION_COOKIE_SECURE=false
# 포털 SSO 세션 절대 만료 12시간을 넘기지 않는다.
SESSION_HOURS=12

# ── 통합 로그인(dss-auth, OIDC) ──────────────────────────────────────────────
# 담당자 PC 의 개발 포털. 끝에 슬래시를 붙이지 않는다. 주소가 바뀌면 로그인만 막힌다 → 담당자에게 새 주소를 받는다.
SSO_ISSUER=http://192.168.1.132:3100
SSO_CLIENT_ID=dss-inventory
# 포털 발급(개발용). 한 번만 표시된다. 운영용은 다른 값. 🔴 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
SSO_CLIENT_SECRET=
# 포털 등록값과 글자 단위로 같아야 한다. 브라우저도 http://localhost:3800 으로 열어야 한다.
SSO_REDIRECT_URI=http://localhost:3800/api/auth/sso/callback
# 32자 이상. 🔴 AUTH_SESSION_SECRET 과 다른 값. 로그인 왕복 쿠키(code_verifier·state·nonce) 서명용.
SSO_TX_SECRET=

# ── A/S 인수번호 조회 통로 (조각 4, DESIGN 7절) ─────────────────────────────
# 담당자(최희만)가 만들어 주는 읽기 전용 주소. 비어 있으면 「A/S 응답 없음」으로 다룬다 — 저장은 되고 「인수번호 확인 안 됨」이 남는다.
# 예: http://192.168.1.132:3000/api/inventory/intake/{number}   ({number} 자리에 D260701 같은 인수번호)
AS_LOOKUP_URL=
# 통로가 토큰을 요구하면. Authorization: Bearer <값> 으로 보낸다.
AS_LOOKUP_TOKEN=

# ── 다른 사내 시스템에 내주는 읽기 전용 API (/api/v1/parts, API.md) ──────────
# A/S·PO 가 Authorization: Bearer <값> 으로 부른다. 32자 이상. 비어 있으면 API 가 503 으로 닫힌다(화면은 영향 없음).
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INVENTORY_API_TOKEN=

# ── 엑셀 (조각 6) ────────────────────────────────────────────────────────────
# 재고 현황 내려받기 틀(.xlsx). 사람이 만든 틀이고 프로그램은 읽기만 한다. 개발 PC: C:/DSS-INVENTORY-DATA/templates/재고 현황 내려받기 틀.xlsx
STOCK_DOWNLOAD_TEMPLATE_PATH=
# 데이터 폴더. 치워 둔 파일(현황판_사람수정_…xlsx)이 여기에 쌓인다. 개발 PC: C:/DSS-INVENTORY-DATA
INVENTORY_DATA_DIR=
# 한 벌 틀(.xlsx, 과거 줄 2,314줄 값째). scripts/build-workbook-template.ts 로 만든다. 프로그램은 읽기만 한다.
STOCK_WORKBOOK_TEMPLATE_PATH=
# 한 벌 결과물(.xlsx). 프로그램이 1분 주기로 통째로 바꿔 쓴다. 개발 PC: C:/DSS-INVENTORY-DATA/workbook/재고 및 견적 현황판.xlsx
STOCK_WORKBOOK_PATH=
# 사람이 탐색기로 원본 한 벌을 찾아가는 경로(화면 표시 전용). NAS 에서는 공유 폴더 경로(\NAS\…). 비어 있으면 STOCK_WORKBOOK_PATH 를 보인다.
STOCK_WORKBOOK_SHARE_PATH=

# ── 개발 전용 ────────────────────────────────────────────────────────────────
# 관리자가 머리말에서 자기 역할을 기록·보기로 **낮춰** 보며 시험한다(가계정·자체 로그인은 만들지 않는다). 운영(NODE_ENV=production)에서는 무시된다.
DEV_ROLE_OVERRIDE=false
